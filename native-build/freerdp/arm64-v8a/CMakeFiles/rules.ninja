rule C_SHARED_LIBRARY_LINKER__freerdp-client_Release
  command = C:\Windows\system32\cmd.exe /C "$PRE_LINK && "E:\HarmonyOs\DevelopTools\huawei\devecostudio\application\DevEco Studio\sdk\default\openharmony\native\llvm\bin\clang.exe" --target=aarch64-linux-ohos --gcc-toolchain="E:/HarmonyOs/DevelopTools/huawei/devecostudio/application/DevEco Studio/sdk/default/openharmony/native/llvm" --sysroot="E:/HarmonyOs/DevelopTools/huawei/devecostudio/application/DevEco Studio/sdk/default/openharmony/native/sysroot" -fPIC $LANGUAGE_COMPILE_FLAGS $ARCH_FLAGS $LINK_FLAGS -shared $SONAME_FLAG$SONAME -o $TARGET_FILE $in $LINK_PATH $LINK_LIBRARIES && $POST_BUILD"
  description = Linking C shared library $TARGET_FILE
  restat = $RESTAT


